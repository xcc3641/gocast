// Cloudflare deploys this folder on every push to main.
// Static files only: no Worker code runs. `npm run build` writes ./dist.
{
  "name": "gocast-website",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
