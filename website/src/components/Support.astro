---
import Base from "../layouts/Base.astro";
import { t, url, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
---
<Base locale={locale} title={c.s_title} description={c.s_lede} path="support/">
<main class="page">
<a class="back" href={url(locale)}>{c.back}</a>
<h1>{c.s_title}</h1>
<p class="lede">{c.s_lede}</p>
<h2>{c.s_contact_h}</h2>
<p set:html={c.s_contact} />
<h2 class="faq-h">{c.faq_h}</h2>
{c.faq.map((f) => (
<Fragment><h3 set:html={f.q} /><div set:html={f.a} /></Fragment>
))}
</main>
</Base>
