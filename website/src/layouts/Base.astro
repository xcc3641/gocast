---
import { otherLocale, t, url, type Locale } from "../i18n";
import { ICON_SVG, LICENSE, REPO, SITE_CSS } from "../lib/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Page path without the language prefix: "" for the landing page, "support/" etc. */
  path: string;
}

const { locale, title, description, path } = Astro.props;
const c = t(locale);
const other = otherLocale(locale);
// The landing page is wider than the text pages.
const wide = path === "";
---
<!doctype html>
<html lang={c.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="/assets/icon-256.png">
<link rel="icon" href={ICON_SVG} type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="alternate" hreflang={t("en").lang} href={url("en", path)}>
<link rel="alternate" hreflang={t("zh").lang} href={url("zh", path)}>
<link rel="stylesheet" href={SITE_CSS}>
</head>
<body class:list={[wide && "wide"]}>
<header class="nav">
<a class="brand" href={url(locale)}><img src="/assets/icon-256.png" width="28" height="28" alt=""><span>Gocast</span></a>
<nav class="links">
<a class="nav-changelog" href={url(locale, "changelog/")}>{c.changelog}</a>
<a class="nav-support" href={url(locale, "support/")}>{c.support}</a>
<a href={REPO}>GitHub</a>
<a href={url(other, path)} hreflang={t(other).lang}>{c.other_label}</a>
</nav>
</header>
<slot />
<footer>
<span class="copy">{c.copyright}</span>
<a href={url(locale, "support/")}>{c.support}</a>
<a href={url(locale, "privacy/")}>{c.privacy}</a>
<a href={url(locale, "changelog/")}>{c.changelog}</a>
<a href={REPO}>GitHub</a>
<a href={LICENSE}>{c.license}</a>
</footer>
</body>
</html>
